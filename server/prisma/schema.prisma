// --- Configuration Prisma ---
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Modèles de Données HR SaaS ---

/// Modèle Organisation (Company)
/// Représente une entreprise cliente du SaaS.
model Company {
  id       String  @id @default(uuid())
  name     String // Nom de l'entreprise
  address  String? // Adresse physique (optionnel)
  isActive Boolean @default(true)
  logoUrl  String? // Logo de l'entreprise

  subscriptionStatus String    @default("ACTIVE") // ACTIVE | PAST_DUE | SUSPENDED
  subscriptionEndsAt DateTime?
  trialEndsAt        DateTime? // Fin de la période d'essai (7j)
  plan               String    @default("FITINI") // FITINI | LOUBA | KORO
  billingCycle       String    @default("MONTHLY") // MONTHLY | YEARLY
  paymentMode        String    @default("ONLINE") // ONLINE | OFFLINE
  extraEmployees     Int       @default(0)

  // Configuration Paie & Heures Supp
  overtimeRate125    Float     @default(1.25)
  overtimeRate150    Float     @default(1.50)
  overtimeRate200    Float     @default(2.00)
  isLocked           Boolean   @default(false)
  lockedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  managerId String? @unique
  manager   User?   @relation("CompanyManager", fields: [managerId], references: [id])

  users               User[]               @relation("CompanyUsers")
  departments         Department[]
  payments            Payment[]
  tasks               Task[]
  workSchedules       WorkSchedule[]
  payrollItems        PayrollItem[]
  payslips            Payslip[]
  customRoles         CustomRole[]
  disciplinaryCases   DisciplinaryCase[]
  clientRegistrations ClientRegistration[]
  missions            Mission[]
  transactions        CompanyTransaction[]
  expenseReports      ExpenseReport[]

  // Relations avec le Support Client
  supportTickets  SupportTicket[]
  supportChatRoom SupportChatRoom?
  
  // Ventes & POS
  products        Product[]
  saleInvoices    SaleInvoice[]
  supplierProfile SupplierProfile?
  purchaseQuotes  SupplierQuote[] @relation("QuoteBuyer")
  supplierQuotes  SupplierQuote[] @relation("QuoteSupplier")
  directPurchases DirectSupplierOrder[] @relation("DirectBuyer")
  directSales     DirectSupplierOrder[] @relation("DirectSupplier")
}

model SupplierProfile {
  companyId   String  @id
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sector      String
  city        String
  description String
  address     String
  email       String
  phone       String
  published   Boolean @default(false)
}

model SupplierQuote {
  id           String   @id
  buyerId      String?
  supplierId   String?
  buyerName    String
  supplierName String
  buyer        Company? @relation("QuoteBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  supplier     Company? @relation("QuoteSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  need         String
  quantity     Int
  location     String
  requestedBy  String
  status       String   @default("REQUESTED")
  totalFcfa    Int?
  terms        String?
  validUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        SupplierOrder?

  @@index([buyerId, createdAt])
  @@index([supplierId, createdAt])
}

model SupplierOrder {
  id        String        @id @default(uuid())
  quoteId   String        @unique
  quote     SupplierQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())
}

model DirectSupplierOrder {
  id          String   @id
  buyerId     String?
  supplierId  String?
  buyer       Company? @relation("DirectBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  supplier    Company? @relation("DirectSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  buyerName   String
  supplierName String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(14, 2)
  vatRate     Decimal  @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(14, 2)
  deliveryAddress String
  status      String   @default("PENDING")
  response    String?
  createdAt   DateTime @default(now())

  @@index([buyerId, createdAt])
  @@index([supplierId, createdAt])
}

/// Modèle Cas Disciplinaire (Conflit)
model DisciplinaryCase {
  id          String @id @default(uuid())
  title       String
  description String
  status      String @default("OPEN") // OPEN, UNDER_INVESTIGATION, RESOLVED, CLOSED

  involvedEmployeeId String
  involvedEmployee   User   @relation("DisciplinaryCases", fields: [involvedEmployeeId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Modèle Paiement (Payment)
model Payment {
  id            String  @id @default(uuid())
  amount        Float // Montant de la transaction
  currency      String  @default("XOF")
  status        String  @default("PENDING") // PENDING | SUCCESS | FAILED
  reference     String  @unique // Référence interne
  externalId    String? // ID transaction GeniusPay
  paymentMethod String? // Orange Money, Wave, etc.
  description   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Modèle Utilisateur (Employé)
model User {
  academyProgress AcademyProgress[]
  id        String  @id @default(uuid())
  email     String  @unique
  password  String // Mot de passe crypté (Haché)
  firstName String
  lastName  String
  role      String  @default("EMPLOYEE") // SUPER_ADMIN, COMPANY_ADMIN, HR_MANAGER, HR_ASSISTANT, COMMERCIAL, LIVREUR, EMPLOYEE
  isOnline  Boolean @default(false)

  // Champs RH
  jobTitle String?
  phone    String?
  hireDate DateTime?
  status   String    @default("ACTIVE") // INVITED | ACTIVE | INACTIVE

  baseSalary     Float? // Salaire de base pour la paie
  hourlyRate     Float? // Taux horaire
  dailyRate      Float? // Taux journalier
  paymentMethod  String  @default("MONTHLY") // MONTHLY, DAILY, HOURLY, HYBRID
  salaryCurrency String  @default("XOF") // Devise (FCFA, etc.)
  bankDetails    String? // Infos bancaires (RIB, etc.)

  // GPS Tracking (pour les livreurs)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  // Relation avec l'entreprise
  companyId String?
  company   Company? @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)

  // Si l'utilisateur est un gestionnaire d'entreprise
  managedCompany Company? @relation("CompanyManager")

  // Département
  departmentId String?
  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)

  // Hiérarchie (manager)
  managerId     String?
  manager       User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]  @relation("UserManager")

  // HR Relations
  leaveRequests  LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeaves LeaveRequest[] @relation("ApprovedLeaves")
  documents      Document[]
  attendances    Attendance[]

  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  payrollItems   PayrollItem[]
  payslips       Payslip[]

  // Messagerie & Communications
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  forumPosts       ForumPost[]
  forumComments    ForumComment[]

  // Suggestions
  reportedSuggestions Suggestion[] @relation("Reporter")

  // Demandes d'explication
  receivedExplanations ExplanationRequest[] @relation("TargetEmployee")
  createdExplanations  ExplanationRequest[] @relation("CreatorEmployee")

  // Custom Role (RBAC)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  disciplinaryCases   DisciplinaryCase[]   @relation("DisciplinaryCases")
  clientRegistrations ClientRegistration[] @relation("CommercialRegistrations")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignedTasks Task[]   @relation("AssignedTasks")
  createdTasks  Task[]   @relation("CreatedTasks")

  assignedMissions Mission[] @relation("AssignedMissions")
  createdMissions  Mission[] @relation("CreatedMissions")

  expenseReports         ExpenseReport[]
  approvedExpenseReports ExpenseReport[] @relation("ApprovedExpenses")

  // Relations avec le Support Client
  createdSupportTickets SupportTicket[]        @relation("TicketCreator")
  ticketMessages        SupportTicketMessage[] @relation("TicketMessageSender")
  supportChatMessages   SupportChatMessage[]   @relation("SupportChatMessageSender")

  // Ventes & POS
  sales                 SaleInvoice[]          @relation("CashierSales")
}

model Suggestion {
  id          String  @id @default(uuid())
  nature      String
  description String
  isAnonymous Boolean @default(false)
  status      String  @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  targetAudience String @default("ALL") // ALL, COMPANY_ADMIN, HR

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  companyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExplanationRequest {
  id          String  @id @default(uuid())
  title       String
  description String
  response    String?
  status      String  @default("PENDING") // PENDING, RESPONDED, CLOSED

  employeeId String
  employee   User   @relation("TargetEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy String
  creator   User   @relation("CreatorEmployee", fields: [createdBy], references: [id], onDelete: Cascade)

  companyId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Modèle Département (Department)
model Department {
  id        String  @id @default(uuid())
  name      String // ex: "Ressources Humaines", "Développement"
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees User[]    @relation("DepartmentEmployees")
  messages  Message[]
}

/// Modèle Congés (LeaveRequest)
model LeaveRequest {
  id        String   @id @default(uuid())
  type      String // PAID, UNPAID, SICK, MATERNITY
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED

  employeeId String
  employee   User   @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)

  approverId String?
  approver   User?   @relation("ApprovedLeaves", fields: [approverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Modèle Document (Fiches de paie, Contrats)
model Document {
  id    String @id @default(uuid())
  title String
  type  String // PAYSLIP, CONTRACT, POLICY, OTHER
  url   String // Lien vers le fichier

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/// Modèle Présence (Attendance)
model Attendance {
  id       String    @id @default(uuid())
  date     DateTime
  checkIn  DateTime?
  checkOut DateTime?
  status   String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Géolocalisation
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Modèle Message (Messagerie Instantanée)
model Message {
  id           String      @id @default(uuid())
  content      String
  senderId     String
  sender       User        @relation("SentMessages", fields: [senderId], references: [id])
  recipientId  String?
  recipient    User?       @relation("ReceivedMessages", fields: [recipientId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  attachmentUrl  String?
  attachmentType String?

  createdAt DateTime @default(now())
}

/// Modèle Notification
model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  type       String? // SUGGESTION, EXPLANATION, DOCUMENT, ANNOUNCEMENT, etc.
  resourceId String? // ID of the related resource
  userId     String?
  companyId  String? // Pour les annonces globales à l'entreprise
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

/// Modèle Tâche (Task)
model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  status       String    @default("A_FAIRE") // A_FAIRE, EN_COURS, TERMINEE
  dueDate      DateTime?
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    String
  creator      User      @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Modèles Annonces / Forum d'entreprise
model ForumPost {
  id       String  @id @default(uuid())
  title    String
  content  String
  category String  @default("GENERAL") // GENERAL, ANNOUNCEMENT, EVENT
  fileUrl  String?
  fileType String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments ForumComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForumComment {
  id      String @id @default(uuid())
  content String

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // INFO, WARN, ERROR
  message   String
  details   Json?
  source    String? // ex: "PaymentController"
  createdAt DateTime @default(now())
}

/// Modèle pour les rôles personnalisés (Permissions Dynamiques)
model CustomRole {
  id          String   @id @default(uuid())
  name        String // ex: "Comptable", "Directeur", etc.
  permissions String[] // ex: ["VIEW_SALARIES", "MANAGE_USERS", ...]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]

  createdAt DateTime @default(now())
}

/// Modèle Client enregistré par un commercial sur le terrain
model ClientRegistration {
  id String @id @default(uuid())

  // Relation commercial
  commercialId     String
  commercial       User     @relation("CommercialRegistrations", fields: [commercialId], references: [id], onDelete: Cascade)
  registrationDate DateTime @default(now())

  // Identité Client
  lastName  String
  firstName String
  gender    String? // HOMME | FEMME
  birthDate DateTime?

  // Type de client
  clientType String @default("PARTICULIER") // ENTREPRISE | PARTICULIER

  // Infos Entreprise (si applicable)
  companyName        String?
  legalStatus        String?
  sector             String?
  companyDescription String?

  // Localisation
  address String?
  city    String?
  commune String?
  country String? @default("Mali")

  // Contacts
  phoneFix    String?
  phoneMobile String?
  whatsapp    String?
  email       String?

  // Pièce d'identité
  idDocumentType      String? // CNI | PASSEPORT | PERMIS | AUTRE
  idDocumentUrl       String? // URL du scan uploadé (rétrocompatibilité)
  idDocumentUrlRecto  String? // URL du scan recto
  idDocumentUrlVerso  String? // URL du scan verso

  // Rendez-vous
  rdvSubject     String?
  rdvDescription String?
  rdvDate        DateTime?
  rdvTime        String?
  rdvMode        String? // PRESENTIEL | APPEL | VISIO

  // Signatures (canvas base64 -> image URL)
  clientSignatureUrl     String?
  commercialSignatureUrl String?

  // Consentement
  consentMode  String?   @default("SIGNATURE") // SIGNATURE | CHECKBOX
  consentGiven Boolean   @default(false)
  consentDate  DateTime?

  // Statut — directement validé à la soumission
  status String @default("VALIDATED") // VALIDATED

  // Relation entreprise
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Documents additionnels (pièces légales)
  documents ClientDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Documents attachés à un enregistrement client
model ClientDocument {
  id    String @id @default(uuid())
  title String
  url   String
  type  String @default("LEGAL") // LEGAL | CONTRACT | OTHER

  clientRegistrationId String
  clientRegistration   ClientRegistration @relation(fields: [clientRegistrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==========================================
// --- MODULE DE SUPPORT CLIENT (NOUVEAU) ---
// ==========================================

/// Modèle Ticket de Support (Formule FITINI)
model SupportTicket {
  id       String @id @default(uuid())
  title    String // Objet du ticket
  status   String @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority String @default("MEDIUM") // LOW | MEDIUM | HIGH

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([companyId])
  @@index([createdById])
}

/// Messages associés à un Ticket de Support
model SupportTicketMessage {
  id      String @id @default(uuid())
  content String // Contenu de la réponse

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

/// Salon de Chat Support (Formules LOUBA & KORO - un salon par entreprise)
model SupportChatRoom {
  id String @id @default(uuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportChatMessage[]

  @@index([companyId])
}

/// Messages instantanés du Salon de Chat Support
model SupportChatMessage {
  id      String  @id @default(uuid())
  content String // Texte du message
  isRead  Boolean @default(false) // Pour les notifications non lues

  roomId String
  room   SupportChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SupportChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([roomId])
}

/// Modèle Mission (Livraison & Prospection)
model Mission {
  id          String    @id @default(uuid())
  title       String
  description String?
  type        String // LIVRAISON, PROSPECTION
  status      String    @default("EN_ATTENTE") // EN_ATTENTE, VALIDEE
  dueDate     DateTime?

  // Client Info
  clientName  String?
  clientPhone String?
  address     String?

  // Validation
  validationMode String? // SIGNATURE, CHECKBOX
  signatureUrl   String? // Base64 de la signature
  validatedAt    DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation("AssignedMissions", fields: [assignedToId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedMissions", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([assignedToId])
}

/// Modèle pour les paramètres globaux (ex: Numéros WhatsApp)
model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// --- MODULE DE PAIE ET HORAIRES (NEW)   ---
// ==========================================

/// Modèle Horaire de Travail
model WorkSchedule {
  id               String   @id @default(uuid())
  name             String   // ex: "Standard 8h-17h"
  type             String   @default("STANDARD") // STANDARD, SHIFT, NIGHT, FLEXIBLE
  startTime        String?  // "08:00"
  endTime          String?  // "17:00"
  breakMinutes     Int      @default(60)
  hoursPerDay      Float    @default(8)
  hoursPerWeek     Float    @default(40)
  
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  users            User[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Modèle pour Primes & Déductions
model PayrollItem {
  id          String   @id @default(uuid())
  name        String   // "Prime de Transport", "Retard"
  type        String   // BONUS, DEDUCTION
  amountType  String   // FIXED, PERCENTAGE
  amount      Float
  isMonthly   Boolean  @default(false) // Vrai = Récurrent chaque mois
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  employeeId  String?
  employee    User?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

/// Modèle Fiche de Paie (Payslip)
model Payslip {
  id              String   @id @default(uuid())
  periodStart     DateTime
  periodEnd       DateTime
  
  // Données de base
  paymentMethod   String   // MONTHLY, DAILY, HOURLY, HYBRID
  baseSalary      Float
  
  // Temps travaillé
  daysWorked      Float
  hoursWorked     Float
  overtimeHours   Float
  
  // Congés
  paidLeaveDays   Float
  unpaidLeaveDays Float
  
  // Montants calculés
  overtimeAmount  Float
  bonusAmount     Float
  deductionAmount Float
  netSalary       Float
  
  status          String   @default("DRAFT") // DRAFT, VALIDATED, PAID
  pdfUrl          String?
  
  employeeId      String
  employee        User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// --- MODULE COMPTABILITE (ACCOUNTING)   ---
// ==========================================

/// Modèle Transaction (Trésorerie interne de l'entreprise)
model CompanyTransaction {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  type        String   // INCOME, EXPENSE
  category    String   // ex: Vente, Loyer, Matériel, Salaire, Autre
  date        DateTime @default(now())
  reference   String?  // N° de facture ou reçu externe
  description String?

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Modèle Note de Frais (Expense Report)
model ExpenseReport {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  date        DateTime @default(now())
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  category    String   @default("AUTRE")   // ex: DEPLACEMENT, REPAS, MATERIEL, AUTRE
  receiptUrl  String?  // Photo du reçu
  description String?

  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy   User?   @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Modèle Diffusion Système par Super Admin (Broadcast Notifications & Emails)
model SystemBroadcast {
  id               String   @id @default(uuid())
  subject          String
  message          String
  targetType       String   @default("ALL") // ALL | SELECTED_COMPANIES | PLAN_FILTER | ROLE_FILTER
  targetPlan       String?  // FITINI, LOUBA, KORO
  targetRole       String?  // COMPANY_ADMIN, HR_MANAGER, etc.
  targetCompanyIds String[] @default([])
  sendEmail        Boolean  @default(true)
  sendInApp        Boolean  @default(true)
  attachmentUrl    String?
  attachmentName   String?

  createdById      String
  createdAt        DateTime @default(now())
}

/// Configuration du Pixel Meta / Facebook & API Conversions (Super-Admin)
model MetaPixelConfig {
  id                 String   @id @default(uuid())
  pixelId            String   @default("3595484767284161")
  conversionsApiToken String?  // Access token Meta Conversions API (CAPI)
  testEventCode      String?  // Code d'événement de test Meta (ex: TEST12345)
  webhookVerifyToken String?  @default("bamousso_meta_lead_token_2026") // Token de vérification Webhook Meta Lead Ads
  isEnabled          Boolean  @default(true)
  isCapiEnabled      Boolean  @default(true)
  trackPageViews     Boolean  @default(true)
  trackRegistrations Boolean  @default(true)
  trackSubscribes    Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

/// Enregistrement des Événements du Pixel Meta (Navigateur + API Conversions CAPI)
model MetaPixelEvent {
  id           String   @id @default(uuid())
  eventName    String   // PageView, Lead, CompleteRegistration, Subscribe, ProspectClick, Contact, Custom
  eventSource  String   @default("BROWSER") // BROWSER | SERVER_CAPI | BOTH
  userIp       String?
  userAgent    String?
  url          String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  fbclid       String?
  customData   Json?    // Détails supplémentaires (valeur, devise, type de plan, etc.)
  status       String   @default("SUCCESS") // SUCCESS | TEST | FAILED
  capiResponse Json?    // Réponse de l'API Meta Conversions
  createdAt    DateTime @default(now())
}

// ==========================================
// --- MODULE VENTES & FACTURATION (POS)  ---
// ==========================================

/// Modèle Article / Produit (Catalogue)
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  vatRate     Float    @default(0) // Taux de TVA en pourcentage (ex: 18)
  stock       Int?     // Quantité en stock (Optionnel)
  
  directoryPublished    Boolean @default(false)
  directoryPriceOnQuote Boolean @default(false)
  directoryImageUrl     String?

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  saleItems   SaleItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

/// Modèle Facture de Vente
model SaleInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   // Numéro de facture (ex: FAC-2026-001)
  clientName      String?
  clientPhone     String?  // Numéro WhatsApp
  
  totalHT         Float
  totalVAT        Float
  totalTTC        Float
  paymentMethod   String   @default("CASH") // CASH, MOBILE_MONEY, BANK_TRANSFER, CARD
  status          String   @default("PAID") // PAID, PENDING, CANCELLED
  pdfUrl          String?  // Lien vers le PDF généré
  
  // Relations
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  cashierId       String
  cashier         User     @relation("CashierSales", fields: [cashierId], references: [id])
  
  // Ligne de trésorerie associée dans la comptabilité (optionnelle car on ne l'a pas encore définie dans CompanyTransaction relation de retour, on utilise reference dans transaction)
  transactionRef  String?  // Pour faire le lien direct
  
  items           SaleItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
}

/// Modèle Ligne de Vente (Article facturé)
model SaleItem {
  id            String   @id @default(uuid())
  quantity      Int
  unitPrice     Float    // Prix au moment de la vente
  vatRate       Float    // Taux de TVA appliqué
  totalLineTTC  Float    // (unitPrice * quantity) + TVA
  
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  saleInvoiceId String
  saleInvoice   SaleInvoice @relation(fields: [saleInvoiceId], references: [id], onDelete: Cascade)
}


model AcademyProgress {
  userId    String
  courseId  String
  activity  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, courseId, activity])
}

model AcademyCourse {
  id        String   @id @default(uuid())
  content   Json
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
